          <material><ambient>0.52 0.52 0.55 1</ambient><diffuse>0.58 0.58 0.61 1</diffuse></material>
        </visual>

        <!-- Main lower wall, with an opening only at Junction A. -->
        <collision name="main_lower_west_collision">
          <pose>4.7 -2.6 1.5 0 0 0</pose>
