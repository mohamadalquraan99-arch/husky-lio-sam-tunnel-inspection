        </collision>
        <visual name="junction_b_vertical_ceiling_visual">
          <pose>40 10 3.10 0 0 0</pose>
          <geometry><box><size>5.4 20 0.2</size></box></geometry>
          <material>
            <ambient>0.42 0.42 0.44 1</ambient>
            <diffuse>0.46 0.46 0.48 1</diffuse>
          </material>
          <transparency>0.60</transparency>
