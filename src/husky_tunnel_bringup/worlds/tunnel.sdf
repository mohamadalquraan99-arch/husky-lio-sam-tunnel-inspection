          <geometry><box><size>5.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.48 0.50 0.54 1</ambient><diffuse>0.54 0.56 0.60 1</diffuse></material>
        </visual>

        <!-- East loop outer wall and top outer wall. -->
        <collision name="east_vertical_outer_collision">
          <pose>42.6 12.6 1.5 0 0 0</pose>
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
        </collision>
        <visual name="east_vertical_outer_visual">
          <pose>42.6 12.6 1.5 0 0 0</pose>
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.56 0.58 0.61 1</diffuse></material>
        </visual>

        <collision name="top_outer_collision">
          <pose>27.5 22.6 1.5 0 0 0</pose>
          <geometry><box><size>30.2 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="top_outer_visual">
          <pose>27.5 22.6 1.5 0 0 0</pose>
          <geometry><box><size>30.2 0.2 3.0</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.56 0.58 0.61 1</diffuse></material>
        </visual>

        <collision name="east_dead_end_collision">
          <pose>55.1 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 5.4 3.0</size></box></geometry>
        </collision>
        <visual name="east_dead_end_visual">
          <pose>55.1 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 5.4 3.0</size></box></geometry>
          <material><ambient>0.48 0.50 0.54 1</ambient><diffuse>0.54 0.56 0.60 1</diffuse></material>
        </visual>

        <!-- Solid central rock mass forms the inner walls of the loop. -->
        <collision name="central_rock_collision">
          <pose>27.5 10.0 1.5 0 0 0</pose>
          <geometry><box><size>19.8 14.8 3.0</size></box></geometry>
        </collision>
        <visual name="central_rock_visual">
          <pose>27.5 10.0 1.5 0 0 0</pose>
          <geometry><box><size>19.8 14.8 3.0</size></box></geometry>
          <material>
            <ambient>0.25 0.27 0.30 1</ambient>
            <diffuse>0.31 0.33 0.36 1</diffuse>
          </material>
        </visual>

        <!-- ==================== LIDAR LANDMARKS ==================== -->
        <!-- These physical features intentionally break corridor symmetry. -->

        <collision name="entrance_marker_collision">
          <pose>3.0 2.15 0.8 0 0 0</pose>
          <geometry><box><size>0.5 0.7 1.6</size></box></geometry>
        </collision>
        <visual name="entrance_marker_visual">
          <pose>3.0 2.15 0.8 0 0 0</pose>
          <geometry><box><size>0.5 0.7 1.6</size></box></geometry>
          <material><ambient>0.75 0.18 0.12 1</ambient><diffuse>0.85 0.22 0.15 1</diffuse></material>
        </visual>

        <collision name="main_marker_one_collision">
          <pose>9.0 -2.12 0.55 0 0 0</pose>
