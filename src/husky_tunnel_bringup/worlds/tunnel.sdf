          <material><ambient>0.52 0.52 0.55 1</ambient><diffuse>0.58 0.58 0.61 1</diffuse></material>
        </visual>

        <!-- West vertical leg and south branch outer walls. -->
        <collision name="west_vertical_outer_north_collision">
          <pose>12.4 12.6 1.5 0 0 0</pose>
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
        </collision>
        <visual name="west_vertical_outer_north_visual">
          <pose>12.4 12.6 1.5 0 0 0</pose>
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.56 0.58 0.61 1</diffuse></material>
        </visual>

        <collision name="south_branch_west_collision">
          <pose>12.4 -10.3 1.5 0 0 0</pose>
          <geometry><box><size>0.2 15.4 3.0</size></box></geometry>
        </collision>
        <visual name="south_branch_west_visual">
          <pose>12.4 -10.3 1.5 0 0 0</pose>
          <geometry><box><size>0.2 15.4 3.0</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.56 0.58 0.61 1</diffuse></material>
