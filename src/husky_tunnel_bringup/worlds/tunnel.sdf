          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.56 0.58 0.61 1</diffuse></material>
        </visual>

        <collision name="south_dead_end_collision">
          <pose>15 -18.1 1.5 0 0 0</pose>
          <geometry><box><size>5.4 0.2 3.0</size></box></geometry>
        </collision>
