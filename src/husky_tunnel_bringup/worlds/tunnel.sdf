        <collision name="top_loop_ceiling_collision">
          <pose>27.5 20 3.10 0 0 0</pose>
          <geometry><box><size>25 5.4 0.2</size></box></geometry>
        </collision>
        <visual name="top_loop_ceiling_visual">
          <pose>27.5 20 3.10 0 0 0</pose>
          <geometry><box><size>25 5.4 0.2</size></box></geometry>
          <material>
            <ambient>0.42 0.42 0.44 1</ambient>
            <diffuse>0.46 0.46 0.48 1</diffuse>
          </material>
          <transparency>0.60</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>

        <!-- ==================== OUTER WALLS ==================== -->

        <!-- Main upper wall, with openings at Junction A and Junction B. -->
        <collision name="main_upper_west_collision">
          <pose>4.7 2.6 1.5 0 0 0</pose>
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
