<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="tunnel">

    <gravity>0 0 -9.81</gravity>

    <physics name="lightweight_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      name="ignition::gazebo::systems::Physics"
      filename="libignition-gazebo-physics-system.so"/>
    <plugin
      name="ignition::gazebo::systems::UserCommands"
      filename="libignition-gazebo-user-commands-system.so"/>
    <plugin
      name="ignition::gazebo::systems::SceneBroadcaster"
      filename="libignition-gazebo-scene-broadcaster-system.so"/>
    <plugin
      name="ignition::gazebo::systems::Sensors"
      filename="libignition-gazebo-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      name="ignition::gazebo::systems::Imu"
      filename="libignition-gazebo-imu-system.so"/>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.10 0.10 0.12 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="network_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>20 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!--
      Tunnel-network centre lines:

        Entrance/main:  (-3, 0)  -> (55, 0)
        Junction A:     (15, 0)
        South branch:   (15, 0)  -> (15, -18)
        West loop leg:  (15, 0)  -> (15, 20)
        Top loop:       (15, 20) -> (40, 20)
        East loop leg:  (40, 20) -> (40, 0)
        Junction B:     (40, 0)
        East dead end:  (40, 0)  -> (55, 0)

      Clear tunnel width: approximately 5.0 m
      Clear tunnel height: approximately 3.0 m
    -->

    <model name="tunnel_network">
      <static>true</static>
      <link name="network_link">

        <!-- ==================== FLOORS ==================== -->

        <collision name="main_floor_collision">
          <pose>26 0 -0.10 0 0 0</pose>
          <geometry><box><size>58 5.2 0.2</size></box></geometry>
        </collision>
        <visual name="main_floor_visual">
          <pose>26 0 -0.10 0 0 0</pose>
          <geometry><box><size>58 5.2 0.2</size></box></geometry>
          <material>
            <ambient>0.26 0.26 0.28 1</ambient>
            <diffuse>0.30 0.30 0.32 1</diffuse>
          </material>
        </visual>

        <collision name="junction_a_vertical_floor_collision">
          <pose>15 1 -0.10 0 0 0</pose>
          <geometry><box><size>5.2 38 0.2</size></box></geometry>
        </collision>
        <visual name="junction_a_vertical_floor_visual">
          <pose>15 1 -0.10 0 0 0</pose>
          <geometry><box><size>5.2 38 0.2</size></box></geometry>
          <material>
            <ambient>0.27 0.27 0.29 1</ambient>
            <diffuse>0.31 0.31 0.33 1</diffuse>
          </material>
        </visual>

        <collision name="junction_b_vertical_floor_collision">
          <pose>40 10 -0.10 0 0 0</pose>
          <geometry><box><size>5.2 20 0.2</size></box></geometry>
        </collision>
        <visual name="junction_b_vertical_floor_visual">
          <pose>40 10 -0.10 0 0 0</pose>
          <geometry><box><size>5.2 20 0.2</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.30 1</ambient>
            <diffuse>0.32 0.32 0.34 1</diffuse>
          </material>
        </visual>

        <collision name="top_loop_floor_collision">
          <pose>27.5 20 -0.10 0 0 0</pose>
          <geometry><box><size>25 5.2 0.2</size></box></geometry>
        </collision>
        <visual name="top_loop_floor_visual">
          <pose>27.5 20 -0.10 0 0 0</pose>
          <geometry><box><size>25 5.2 0.2</size></box></geometry>
          <material>
            <ambient>0.29 0.29 0.31 1</ambient>
            <diffuse>0.33 0.33 0.35 1</diffuse>
          </material>
        </visual>

        <!-- Fill the two missing outer loop-corner floors. -->
        <visual name="northwest_corner_floor_visual">
          <pose>13.7 21.3 -0.10 0 0 0</pose>
          <geometry>
            <box><size>2.6 2.6 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.29 0.29 0.31 1</ambient>
            <diffuse>0.33 0.33 0.35 1</diffuse>
          </material>
        </visual>

        <visual name="northeast_corner_floor_visual">
          <pose>41.3 21.3 -0.10 0 0 0</pose>
          <geometry>
            <box><size>2.6 2.6 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.29 0.29 0.31 1</ambient>
            <diffuse>0.33 0.33 0.35 1</diffuse>
          </material>
        </visual>

        <!-- ==================== CEILINGS ==================== -->

        <collision name="main_ceiling_collision">
          <pose>26 0 3.10 0 0 0</pose>
          <geometry><box><size>58 5.4 0.2</size></box></geometry>
        </collision>
        <visual name="main_ceiling_visual">
          <pose>26 0 3.10 0 0 0</pose>
          <geometry><box><size>58 5.4 0.2</size></box></geometry>
          <material>
            <ambient>0.42 0.42 0.44 1</ambient>
            <diffuse>0.46 0.46 0.48 1</diffuse>
          </material>
          <transparency>0.60</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>

        <collision name="junction_a_vertical_ceiling_collision">
          <pose>15 1 3.10 0 0 0</pose>
          <geometry><box><size>5.4 38 0.2</size></box></geometry>
        </collision>
        <visual name="junction_a_vertical_ceiling_visual">
          <pose>15 1 3.10 0 0 0</pose>
          <geometry><box><size>5.4 38 0.2</size></box></geometry>
          <material>
            <ambient>0.42 0.42 0.44 1</ambient>
            <diffuse>0.46 0.46 0.48 1</diffuse>
          </material>
          <transparency>0.60</transparency>
          <cast_shadows>false</cast_shadows>
