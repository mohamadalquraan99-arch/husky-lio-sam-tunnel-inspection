<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tunnel">
    <!-- Core Gazebo systems required by the simulation and sensors. -->
    <plugin name="ignition::gazebo::systems::Physics"
            filename="libignition-gazebo-physics-system.so"/>
    <plugin name="ignition::gazebo::systems::UserCommands"
            filename="libignition-gazebo-user-commands-system.so"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster"
            filename="libignition-gazebo-scene-broadcaster-system.so"/>
    <plugin name="ignition::gazebo::systems::Sensors"
            filename="libignition-gazebo-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="ignition::gazebo::systems::Imu"
            filename="libignition-gazebo-imu-system.so"/>

    <!-- 250 physics updates/s matches the 4 ms step and reduces CPU load. -->
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>1 1 1 1</background>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <shadows>false</shadows>
    </scene>

    <atmosphere type="adiabatic">
      <temperature>288</temperature>
      <temperature_gradient>0.3</temperature_gradient>
    </atmosphere>
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Staging area: same model and pose as the saved world. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/subt_tunnel_staging_area/11</uri>
      <name>staging_area</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Staging-area barriers: unchanged names and poses. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_0_-1</name>
      <pose>8 -11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_0_1</name>
      <pose>8 11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_1_-1</name>
      <pose>3.7 -11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_1_1</name>
      <pose>3.7 11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_2_-1</name>
      <pose>-0.6 -11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_2_1</name>
      <pose>-0.6 11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_3_-1</name>
      <pose>-4.9 -11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_3_1</name>
      <pose>-4.9 11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_4_-1</name>
      <pose>-9.2 -11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_4_1</name>
      <pose>-9.2 11 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_-9.5_-2</name>
      <pose>10.5 -8.6 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_-9.5_2</name>
      <pose>10.5 8.6 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_-32_-2</name>
      <pose>-12 -8.6 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_-32_-1</name>
      <pose>-12 -4.3 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_-32_0</name>
      <pose>-12 0 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_-32_1</name>
      <pose>-12 4.3 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
      <name>barrier_-32_2</name>
      <pose>-12 8.6 0 0 0 1.5708</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fiducial/4</uri>
      <name>artifact_origin</name>
      <pose>10 0 0 0 0 0</pose>
    </include>

    <!-- Tunnel geometry: identical tile types, names, poses, and topology. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile 5/14</uri>
      <name>tile_4</name>
      <pose>40 20 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile 5/14</uri>
      <name>tile_6</name>
      <pose>20 0 0 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile 1/5</uri>
      <name>tile_7</name>
      <pose>40 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile 2/16</uri>
      <name>tile_16_1</name>
      <pose>39.9556 -18.5614 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile 1/5</uri>
      <name>tile_18_2</name>
      <pose>58.8393 -18.4907 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile 2/16</uri>
      <name>tile_3_1</name>
      <pose>58.8266 0.068347 0 0 0 -1.5708</pose>
    </include>

    <!-- Block all three branch ends at their original saved positions. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile Blocker/12</uri>
      <name>tile_19_2_1</name>
      <pose>70.2529 -18.5861 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile Blocker/12</uri>
      <name>tile_19_2_2</name>
      <pose>59.2521 -30.1853 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel Tile Blocker/12</uri>
      <name>tile_19_2_3</name>
      <pose>40.0669 29.8342 0 0 0 0</pose>
    </include>
  </world>
</sdf>
